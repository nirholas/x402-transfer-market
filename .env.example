# ---- Payment receive addresses ---------------------------------------------
# Both rails are always offered. These suite defaults are public receive
# addresses — change them to your own to be paid.

# EVM (Base / Base Sepolia) USDC receive address
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# Solana USDC receive address
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW

# ---- Networks ---------------------------------------------------------------
# EVM rail: base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# Solana rail: devnet (default) or mainnet-beta.
SOLANA_NETWORK=devnet
# Solana RPC used by the browser checkout helper (pages demo only).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ---- Facilitators (one per rail — they are NOT interchangeable) -------------
# EVM rail. The x402.org reference facilitator settles Base.
FACILITATOR_URL=https://x402.org/facilitator
# Solana rail. x402.org's facilitator does not settle Solana, so this defaults
# to PayAI's, which does. Check any candidate with GET <url>/supported.
SOLANA_FACILITATOR_URL=https://facilitator.payai.network
# Optional: pin the Solana fee-payer sponsor instead of discovering it from the
# Solana facilitator's /supported endpoint.
# SOLANA_FEE_PAYER=

# ---- Server -----------------------------------------------------------------
# HTTP port.
PORT=4023
# Directory for file-based persistence (tokens, listings and transfers ledgers).
DATA_DIR=data

# ---- Artifacts --------------------------------------------------------------
# HMAC-SHA256 secret used to sign every artifact this service issues.
# The dev default is public — ALWAYS set your own in production.
SIGNING_SECRET=change-me-in-production

# ---- Policy -----------------------------------------------------------------
# Highest ask a listing may carry, in dollars.
MAX_ASK=5.00

# ---- Client example (examples/agent-client.ts) ------------------------------
# Funded base-sepolia private key used by the example client to pay the EVM rail.
# PRIVATE_KEY=0x...
# BASE_URL=http://localhost:4023
